<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sideload updater: lets the app hand a downloaded APK to the system package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice dictation: the in-app continuous SpeechRecognizer listens only while the mic is active. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- QR pairing: the scanner reads the host's pairing QR. The camera is optional: pairing still
         works by entering the host URL + 6-digit code, so devices without a camera stay installable. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".DshApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DshMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DshMobile"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="dshmobile" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Crash-loop recovery: does not create AppState/RemoteRepository or the Compose shell.
             Exported so the launcher's static "Safe mode" shortcut can launch it directly.
             Force the DARK platform theme so the light-on-dark recovery UI stays readable
             regardless of the device's day/night setting or a broken app theme. -->
        <activity
            android:name=".SafeModeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Inline free-text question replies from notifications. Exported=false: only the
             notification's mutable PendingIntent can reach it; it never starts the app shell. -->
        <receiver
            android:name=".QuestionReplyReceiver"
            android:exported="false" />

        <service
            android:name=".BackgroundSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".NewSessionTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="New DSH session"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".UsageTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="DSH usage"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.DshWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dsh_widget_info" />
        </receiver>

        <!-- Exposes the downloaded update APK to the package installer via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: Hadal ink ground with the terminal-prompt launcher mark. -->
    <style name="Theme.DshMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#050A08</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">#050A08</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0A1510</item>
    </style>
</resources>
